# Copy to .env and fill in. Never commit the real .env file.

# Groq (OpenAI-compatible API) -- the agent's own LLM calls. Free tier (1,000 req/day).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Tried first, hit a 20 req/day free-tier cap -- kept for reference, unused by default.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Neatlogs tracing (https://app.neatlogs.com)
NEATLOGS_API_KEY=
NEATLOGS_PROJECT_ID=

# GitHub (fine-grained PAT scoped ONLY to the benchmark/demo repos we own)
GITHUB_TOKEN=

# Optional: AWS (if running the agent's LLM calls via Bedrock instead of Anthropic directly)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
