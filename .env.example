# Copy to .env and fill in. Never commit the real .env file.

# Anthropic API (agent's LLM calls)
ANTHROPIC_API_KEY=

# Neatlogs tracing (https://app.neatlogs.com)
NEATLOGS_API_KEY=
NEATLOGS_PROJECT_ID=

# GitHub (fine-grained PAT scoped ONLY to the benchmark/demo repos we own)
GITHUB_TOKEN=

# Optional: AWS (if running the agent's LLM calls via Bedrock instead of Anthropic directly)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
